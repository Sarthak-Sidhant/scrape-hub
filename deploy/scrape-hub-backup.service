[Unit]
Description=Back up the scrape-hub database to object storage
After=postgresql.service

[Service]
Type=oneshot
User=scrapehub
WorkingDirectory=/opt/scrape-hub
EnvironmentFile=/etc/scrape-hub/env
ExecStart=/opt/scrape-hub/.venv/bin/python scripts/backup_db.py
NoNewPrivileges=true
PrivateTmp=false
