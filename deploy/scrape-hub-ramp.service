[Unit]
Description=Measure how much load each GePNIC portal server takes (capacity ramp)
After=postgresql.service

[Service]
Type=oneshot
User=scrapehub
WorkingDirectory=/opt/scrape-hub
EnvironmentFile=/etc/scrape-hub/env
ExecStart=/opt/scrape-hub/.venv/bin/python scripts/ramp.py
TimeoutStartSec=1800
NoNewPrivileges=true
