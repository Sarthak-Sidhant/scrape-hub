[Unit]
Description=Move old telemetry rows (probes, metrics, batches) to object storage, then delete them from the database
After=postgresql.service

[Service]
Type=oneshot
User=scrapehub
WorkingDirectory=/opt/scrape-hub
EnvironmentFile=/etc/scrape-hub/env
ExecStart=/opt/scrape-hub/.venv/bin/python scripts/archive_telemetry.py
TimeoutStartSec=3600
NoNewPrivileges=true
