# /etc/scrape-hub/env  (chmod 640, root:scrapehub)
DATABASE_URL=postgresql://scrape_hub:CHANGE_ME@127.0.0.1:5432/scrape_hub
OIDC_AUDIENCE=https://scrape.s1d.me
ALLOWED_OWNERS=Sarthak-Sidhant
# ALLOWED_REPOS=Sarthak-Sidhant/scrape-hub,Sarthak-Sidhant/results-tenders
# Same hashed password file as status.s1d.me (created by set-status-password.sh).
STATUS_PASSWORD_FILE=/etc/statusd/password
# Set only when running behind cloudflared/nginx, so the runner IP comes from CF-Connecting-IP.
TRUST_PROXY=1
# SCRAPE_LEGACY_TOKEN=   # leave unset: OIDC only
